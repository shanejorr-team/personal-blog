# build output
dist/
.vercel/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Claude Code settings
.claude/

# Database backups
backups/
portfolio-json-backup/

# SQLite temporary files
*.db-journal
*.db.backup

# Scratch folder - ignore images and generated files
scratch/**/*.jpg
scratch/**/*.jpeg
scratch/**/*.png
scratch/**/venv/
scratch/**/models/
scratch/**/__pycache__/
scratch/**/blurred_photos/
scratch/**/original_photos/

# Footbench runtime data (raw responses, rendered figures, judgments)
footbench/artifacts/*
!footbench/artifacts/tables/
footbench/artifacts/tables/*
!footbench/artifacts/tables/responses.json
# Keep the small per-instance candidate records the judge stage reads (so re-judging is
# reproducible from a clone); rendered figures and other large/derived artifacts stay ignored.
!footbench/artifacts/instances/
footbench/artifacts/instances/*
!footbench/artifacts/instances/*/
footbench/artifacts/instances/*/*
!footbench/artifacts/instances/*/response.json
!footbench/artifacts/instances/*/checks.json
footbench/.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
