---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lightbox from '../components/Lightbox.astro';
import '../styles/global.css';

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/photography/encuentro/*.jpg',
  { eager: true }
);

const entries = Object.entries(photoModules).sort(([a], [b]) => a.localeCompare(b));

const photos = await Promise.all(
  entries.map(async ([path, mod]) => {
    const img = mod.default;
    const aspectRatio = img.width / img.height;
    const filename = path.split('/').pop()!;

    const lightbox = await getImage({
      src: img,
      width: 1440,
      height: Math.round(1440 / aspectRatio),
      format: 'webp',
      quality: 90,
    });
    const lqip = await getImage({
      src: img,
      width: 20,
      height: Math.round(20 / aspectRatio),
      format: 'webp',
      quality: 20,
    });

    return {
      filename,
      img,
      aspectRatio,
      lightboxSrc: lightbox.src,
      lqipSrc: lqip.src,
      originalSrc: img.src,
    };
  })
);

const ROW_HEIGHT = 280;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>Encuentro</title>
    <meta name="description" content="A private family album." />

    <meta name="robots" content="noindex, nofollow, noarchive, noimageindex, nosnippet, noai, noimageai" />
    <meta name="googlebot" content="noindex, nofollow, noimageindex" />
    <meta name="googlebot-image" content="noindex" />
    <meta name="GPTBot" content="noindex, nofollow" />
    <meta name="ClaudeBot" content="noindex, nofollow" />
    <meta name="anthropic-ai" content="noindex, nofollow" />
    <meta name="Google-Extended" content="noindex, nofollow" />
    <meta name="CCBot" content="noindex, nofollow" />
    <meta name="PerplexityBot" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,400;1,500;1,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-white text-gray-900 min-h-screen"
    data-lightbox-allow-download="true"
  >
    <header class="border-b border-gray-200 py-5 text-center">
      <span class="text-sm font-semibold tracking-[0.4em] text-gray-600">ENCUENTRO</span>
    </header>

    <main class="container mx-auto px-4 py-12 md:py-16">
      <section class="text-center mb-16 md:mb-20 pt-6 md:pt-10">
        <h1 class="encuentro-title text-7xl md:text-8xl mb-6 leading-none">Encuentro</h1>
        <div class="encuentro-divider mx-auto mb-6" aria-hidden="true"></div>
        <p class="text-base md:text-lg text-gray-700 leading-loose tracking-wide">
          April 9, 2026<br />
          Bogotá, Colombia
        </p>
      </section>

      <section class="mb-12 md:mb-16">
        <div class="mx-auto max-w-4xl aspect-video bg-gray-900 rounded-md overflow-hidden shadow-md">
          <video
            controls
            preload="metadata"
            poster="https://pub-f4833d2b192d47bba0b114ceec61d2f3.r2.dev/encuentro-poster.jpg"
            class="w-full h-full object-contain bg-black"
          >
            <source
              src="https://pub-f4833d2b192d47bba0b114ceec61d2f3.r2.dev/encuentro-video.mp4"
              type="video/mp4"
            />
            Your browser does not support the video tag.
          </video>
        </div>
      </section>

      <section>
        <div class="flex flex-wrap gap-3 md:gap-4 justify-center">
          {photos.map((photo, index) => (
            <div
              class="photo-grid-item-wrapper group relative"
              style={`width: ${ROW_HEIGHT * photo.aspectRatio}px; height: ${ROW_HEIGHT}px; max-width: 100%;`}
            >
              <button
                type="button"
                class="photo-grid-item block w-full h-full overflow-hidden rounded-sm cursor-zoom-in"
                aria-label={`Open photo ${photo.filename}`}
                data-group="encuentro"
                data-index={index}
                data-lightbox-src={photo.lightboxSrc}
                data-original-src={photo.originalSrc}
                data-lqip-src={photo.lqipSrc}
                data-alt={photo.filename}
                data-caption=""
                data-location-name=""
                data-country-name=""
                data-download-filename={photo.filename}
              >
                <Picture
                  src={photo.img}
                  formats={['avif', 'webp']}
                  widths={[Math.round(ROW_HEIGHT * photo.aspectRatio * 2)]}
                  sizes={`${Math.round(ROW_HEIGHT * photo.aspectRatio)}px`}
                  alt={photo.filename}
                  loading="lazy"
                  quality={90}
                  class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105"
                />
              </button>

              <a
                href={photo.originalSrc}
                download={photo.filename}
                class="absolute top-2 right-2 z-10 inline-flex items-center justify-center w-9 h-9 rounded-full bg-black/70 text-white opacity-0 group-hover:opacity-100 hover:bg-black/90 transition-opacity duration-200"
                aria-label={`Download ${photo.filename}`}
                title="Download full-resolution photo"
                onclick="event.stopPropagation();"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </a>
            </div>
          ))}
        </div>
      </section>
    </main>

    <Lightbox />

    <style is:global>
      html {
        font-family: 'Inter', system-ui, sans-serif;
      }
      body {
        font-family: 'Inter', system-ui, sans-serif;
      }
      .encuentro-title {
        font-family: 'Cormorant Garamond', 'Cormorant', Georgia, serif;
        font-style: italic;
        font-weight: 500;
        letter-spacing: 0.005em;
        color: #1f2937;
      }
      .encuentro-divider {
        width: 56px;
        height: 1px;
        background-color: #9ca3af;
      }
    </style>
  </body>
</html>
