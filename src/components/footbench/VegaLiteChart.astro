---
type Props = {
  specUrl: string;
  title: string;
  minWidth?: number;
};

const { specUrl, title, minWidth = 760 } = Astro.props;
---

<figure
  class="footbench-chart"
  data-footbench-chart
  data-spec-url={specUrl}
  aria-label={title}
  style={`--footbench-chart-min-width: ${minWidth}px;`}
>
  <div class="flc-scroll">
    <div class="flc-target" data-chart-target></div>
  </div>
  <p class="flc-status" data-chart-status>Loading chart...</p>
</figure>

<script>
  type VegaEmbed = (
    element: Element,
    spec: unknown,
    options: Record<string, unknown>,
  ) => Promise<unknown>;

  const VEGA_SCRIPT_URLS = [
    'https://cdn.jsdelivr.net/npm/vega@5.25.0/build/vega.min.js',
    'https://cdn.jsdelivr.net/npm/vega-lite@5.16.3/build/vega-lite.min.js',
    'https://cdn.jsdelivr.net/npm/vega-embed@6.24.0/build/vega-embed.min.js',
  ];

  let vegaRuntimePromise: Promise<void> | undefined;

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const existingScript = document.querySelector<HTMLScriptElement>(`script[src="${src}"]`);

      if (existingScript?.dataset.loaded === 'true') {
        resolve();
        return;
      }

      const script = existingScript ?? document.createElement('script');
      const onLoad = () => {
        script.dataset.loaded = 'true';
        cleanup();
        resolve();
      };
      const onError = () => {
        cleanup();
        reject(new Error(`Could not load ${src}`));
      };
      const cleanup = () => {
        script.removeEventListener('load', onLoad);
        script.removeEventListener('error', onError);
      };

      script.addEventListener('load', onLoad, { once: true });
      script.addEventListener('error', onError, { once: true });

      if (!existingScript) {
        script.src = src;
        script.async = false;
        document.head.append(script);
      }
    });
  }

  function loadVegaRuntime(): Promise<void> {
    if (!vegaRuntimePromise) {
      vegaRuntimePromise = VEGA_SCRIPT_URLS.reduce(
        (promise, src) => promise.then(() => loadScript(src)),
        Promise.resolve(),
      );
    }

    return vegaRuntimePromise;
  }

  async function renderFootbenchChart(root: Element) {
    if (!(root instanceof HTMLElement) || root.dataset.rendered === 'true') {
      return;
    }

    const specUrl = root.dataset.specUrl;
    const target = root.querySelector('[data-chart-target]');
    const status = root.querySelector('[data-chart-status]');

    if (!specUrl || !target) {
      return;
    }

    root.dataset.rendered = 'true';

    try {
      await loadVegaRuntime();

      const response = await fetch(specUrl);
      if (!response.ok) {
        throw new Error(`Could not fetch chart spec: ${response.status}`);
      }

      const vegaEmbed = (window as Window & { vegaEmbed?: VegaEmbed }).vegaEmbed;
      if (!vegaEmbed) {
        throw new Error('vegaEmbed is unavailable.');
      }

      const spec = await response.json();
      target.replaceChildren();
      await vegaEmbed(target, spec, { actions: false, renderer: 'svg' });

      root.classList.add('is-loaded');
      if (status instanceof HTMLElement) {
        status.hidden = true;
      }
    } catch (error) {
      root.dataset.rendered = 'false';
      root.classList.add('has-error');
      if (status instanceof HTMLElement) {
        status.hidden = false;
        status.textContent = 'Chart failed to load.';
      }
      console.error(error);
    }
  }

  function renderFootbenchCharts() {
    document.querySelectorAll('[data-footbench-chart]').forEach(renderFootbenchChart);
  }

  renderFootbenchCharts();
  document.addEventListener('astro:page-load', renderFootbenchCharts);
</script>

<style>
  .footbench-chart {
    margin: 2rem 0;
    max-width: 100%;
  }

  .flc-scroll {
    overflow-x: auto;
    padding: 0.25rem 0 0.75rem;
  }

  .flc-target {
    min-height: 16rem;
    min-width: var(--footbench-chart-min-width);
  }

  .footbench-chart.is-loaded .flc-target {
    min-height: 0;
  }

  .flc-status {
    color: rgb(75 85 99);
    font-size: 0.875rem;
    line-height: 1.25rem;
    margin: 0.25rem 0 0;
  }

  :global(.dark) .flc-status {
    color: rgb(156 163 175);
  }

  .footbench-chart.has-error .flc-status {
    color: rgb(185 28 28);
  }

  :global(.dark) .footbench-chart.has-error .flc-status {
    color: rgb(248 113 113);
  }

  .flc-target :global(.vega-embed) {
    max-width: none;
  }

  .flc-target :global(.vega-embed svg) {
    max-width: none;
  }

  .flc-target :global(.mark-line[role='graphics-object']),
  .flc-target :global(.mark-symbol[role='graphics-object']) {
    pointer-events: auto;
  }

  .flc-target :global(.mark-line[role='graphics-object'] path) {
    pointer-events: stroke;
  }
</style>
