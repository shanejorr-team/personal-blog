---
/**
 * InlineFigure - Optimized inline image component for MDX posts
 *
 * Features:
 * - Responsive images with multiple widths
 * - Modern formats (AVIF, WebP) with fallback
 * - Lazy loading for performance
 * - Dark mode support for figcaptions
 * - Consistent quality settings
 *
 * Usage in MDX:
 * ```mdx
 * import InlineFigure from '../../../components/InlineFigure.astro';
 * import photo from './my-photo.jpg';
 *
 * <InlineFigure src={photo} alt="Description" caption="Optional caption" />
 * ```
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  caption,
  loading = 'lazy',
  class: className = ''
} = Astro.props;

// Responsive widths for different screen sizes
// These cover mobile, tablet, and desktop displays
// 1792 provides 2x resolution for retina at max-w-4xl (896px)
const widths = [400, 800, 1200, 1792];

// Sizes attribute helps browser pick the right image
// Based on actual layout: max-w-4xl (896px) container to match hero images
// - Mobile: full width minus padding (100vw - 2rem)
// - Tablet: full width minus padding
// - Desktop: constrained to 896px (max-w-4xl) to match hero image width
const sizes = '(max-width: 640px) calc(100vw - 2rem), (max-width: 1024px) calc(100vw - 2rem), 896px';
---

<figure class="max-w-4xl mx-auto">
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    quality={80}
    loading={loading}
    class:list={['rounded-lg w-full', className]}
  />
  {caption && (
    <figcaption>{caption}</figcaption>
  )}
</figure>
